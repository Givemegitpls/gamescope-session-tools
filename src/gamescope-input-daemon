#!/usr/bin/env python3
"""Gamescope Input Daemon — volume and power button handling for gamescope sessions.

Reads evdev input devices and reacts to the volume keys (via wpctl) and the
power button (forwarded to Steam). The daemon is inert until told which session
is active over its control socket:

    gamescope   grab the power button, handle volume/power keys
    desktop     release all devices, do not interfere with the compositor
    status      report the current mode
    rescan      re-read /dev/input and open every readable device
    stop        shut the daemon down

At startup the daemon does NOT grab anything. It waits for a command, so a
compositor running on the desktop keeps its own key bindings (e.g. the
XF86PowerOff binding) until a gamescope session is actually active.

A background watcher keeps the open device set in sync with the kernel: it
subscribes to udev and reconciles on every add/remove/change event, which is
what makes hot-plug and suspend/resume work. Devices are matched by identity
(name/phys/uniq), not by their ``eventN`` node, because those numbers change
when a device is re-registered. Without pyudev the watcher falls back to
polling /dev/input.
"""

from __future__ import annotations

import asyncio
import contextlib
import ctypes
import errno
import os
import re
import signal
import sys
from collections import Counter
from collections.abc import AsyncIterator
from dataclasses import dataclass
from functools import partial
from pathlib import Path
from typing import Final, Protocol, cast, final

import evdev

try:
    import pyudev  # pyright: ignore[reportMissingImports]
except ImportError:  # pragma: no cover — declared as a package dependency
    pyudev = None

DOUBLE_PRESS_SECONDS: Final[float] = 0.6
UDEV_DEBOUNCE_SECONDS: Final[float] = 0.3
POLL_INTERVAL_SECONDS: Final[float] = 2.0
SAFETY_INTERVAL_SECONDS: Final[float] = 30.0
POWER_BUTTON_PHYS: Final[tuple[str, ...]] = (
    "LNXPWRBN/button/input0",
    "PNP0C0C/button/input0",
)
STEAM_URL_MENU: Final[str] = "steam://longpowerpress"
STEAM_URL_SLEEP: Final[str] = "steam://shortpowerpress"
DEFAULT_SOCKET: Final[Path] = Path(
    "/run/gamescope-input-daemon/gamescope-input-daemon.sock"
)
INPUT_DIR: Final[Path] = Path("/dev/input")
PROCDEV_PATH: Final[Path] = Path("/proc/bus/input/devices")

MODE_GAMESCOPE: Final[str] = "gamescope"
MODE_DESKTOP: Final[str] = "desktop"


def _set_pdeathsig(sig: int) -> None:
    """Ask the kernel to deliver a signal when the parent dies."""
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        _: int = libc.prctl(1, sig)  # pyright: ignore[reportAny] — PR_SET_PDEATHSIG = 1
    except OSError:
        pass


def _is_readable(path: str) -> bool:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return False
    os.close(fd)
    return True


def _open_device(path: str) -> evdev.InputDevice[str]:
    """Open a device read-only.

    ``evdev.InputDevice`` accepts a path or a file descriptor; given a
    descriptor it re-opens with ``O_RDWR``, which fails for a process that is
    in the ``input`` group but is not root. Passing the path lets evdev fall
    back to ``O_RDONLY`` on ``EACCES``.
    """
    return evdev.InputDevice(path)  # pyright: ignore[reportUnknownMemberType,reportUnknownVariableType]


@dataclass(frozen=True)
class _DeviceInfo:
    """What identifies a device, independently of its /dev node."""

    path: str
    name: str
    phys: str
    uniq: str


def _fingerprint(info: _DeviceInfo) -> tuple[str, str, str]:
    return (info.name, info.phys, info.uniq)


_PROCDEV_NAME_RE: Final[re.Pattern[str]] = re.compile(r'^N: Name="(.*)"$')
_PROCDEV_PHYS_RE: Final[re.Pattern[str]] = re.compile(r"^P: Phys=(.*)$")
_PROCDEV_UNIQ_RE: Final[re.Pattern[str]] = re.compile(r"^U: Uniq=(.*)$")
_PROCDEV_HANDLERS_RE: Final[re.Pattern[str]] = re.compile(r"^H: Handlers=(.*)$")
_EVENT_NODE_RE: Final[re.Pattern[str]] = re.compile(r"\bevent\d+\b")


def _match_group(pattern: re.Pattern[str], line: str) -> str | None:
    match = pattern.match(line)
    return match.group(1) if match is not None else None


def _devices_from_proc() -> list[_DeviceInfo]:
    try:
        text = PROCDEV_PATH.read_text(errors="replace")
    except OSError:
        return []

    # The indentation of /proc/bus/input/devices differs between kernel
    # versions; normalize the leading whitespace before matching.
    text = re.sub(r"^ +", "", text, flags=re.MULTILINE)

    infos: list[_DeviceInfo] = []
    name = ""
    phys = ""
    uniq = ""
    for line in text.splitlines():
        name_match = _match_group(_PROCDEV_NAME_RE, line)
        if name_match is not None:
            # Start of a new block: reset the identity fields.
            name, phys, uniq = name_match, "", ""
            continue
        phys_match = _match_group(_PROCDEV_PHYS_RE, line)
        if phys_match is not None:
            phys = phys_match
            continue
        uniq_match = _match_group(_PROCDEV_UNIQ_RE, line)
        if uniq_match is not None:
            uniq = uniq_match
            continue
        handlers = _match_group(_PROCDEV_HANDLERS_RE, line)
        if handlers is None:
            continue
        for node in _EVENT_NODE_RE.findall(handlers):
            infos.append(
                _DeviceInfo(path=f"{INPUT_DIR}/{node}", name=name, phys=phys, uniq=uniq)
            )
    return infos


def _readable_input_devices() -> list[_DeviceInfo]:
    """List readable /dev/input/event* nodes with their identity from /proc.

    Unlike ``evdev.list_devices()`` (which defaults to ``writable=True`` and
    therefore returns nothing for a non-root process in the ``input`` group),
    this only requires *read* access.
    """
    infos = _devices_from_proc()
    known = {info.path for info in infos}
    for path in sorted(str(p) for p in INPUT_DIR.glob("event*")):
        if path in known:
            continue
        known.add(path)
        infos.append(_DeviceInfo(path=path, name="", phys="", uniq=""))
    return [info for info in infos if _is_readable(info.path)]


@final
class _OpenDevice:
    """An open evdev device plus the identity it was opened for.

    A plain class rather than a dataclass: basedpyright fails to resolve the
    generic ``evdev.InputDevice[str]`` in a class-body annotation, but resolves
    it fine in a parameter annotation, and identity semantics are wanted here
    anyway.
    """

    def __init__(self, device: evdev.InputDevice[str], info: _DeviceInfo) -> None:
        self.device = device
        self.info = info
        self.task: asyncio.Task[None] | None = None
        self.grabbed = False
        self.failed = False


def _is_alive(node: _OpenDevice) -> bool:
    """Whether the open fd still belongs to the node at its path.

    A suspend or an unplug invalidates the fd even when the path comes back
    later, so compare the device numbers *and* the inode of the open fd with
    the current node.
    """
    try:
        current = os.stat(str(node.device.path))
        opened = os.fstat(node.device.fd)
    except (OSError, ValueError, TypeError):
        return False
    return current.st_rdev == opened.st_rdev and current.st_ino == opened.st_ino


class _UdevMonitor(Protocol):
    """The sliver of ``pyudev.Monitor`` that this daemon uses."""

    def fileno(self) -> int: ...

    def poll(self, timeout: float | None = None) -> object | None: ...


def _open_udev_monitor() -> _UdevMonitor | None:
    """Subscribe to udev 'input' events, or return None when unavailable."""
    if pyudev is None:
        return None
    try:
        monitor = pyudev.Monitor.from_netlink(pyudev.Context())
        monitor.filter_by("input")
    except Exception as e:  # noqa: BLE001 — udev is optional at runtime
        _ = sys.stderr.write(f"cannot subscribe to udev events: {e}\n")
        return None
    return cast("_UdevMonitor", monitor)


def _drain_udev(monitor: _UdevMonitor) -> None:
    """Consume every queued event so the monitor stops reporting readable."""
    while monitor.poll(timeout=0) is not None:
        pass


@final
class InputDaemon:
    def __init__(self, socket_path: Path) -> None:
        self._socket_path = socket_path
        self._devices: list[_OpenDevice] = []
        self._shutdown_event = asyncio.Event()
        self._shutdown_flag = False
        self._server: asyncio.AbstractServer | None = None
        self._pending_single_task: asyncio.Task[None] | None = None
        self._last_press_time: float = 0.0
        self._press_count: int = 0
        self._mode: str = MODE_DESKTOP
        self._lock = asyncio.Lock()
        self._watch_task: asyncio.Task[None] | None = None
        self._reconcile_task: asyncio.Task[None] | None = None
        self._no_devices_warned = False

    # ------------------------------------------------------------------ setup

    async def start(self) -> None:
        _set_pdeathsig(signal.SIGTERM)

        loop = asyncio.get_running_loop()
        for sig in (signal.SIGINT, signal.SIGTERM):
            loop.add_signal_handler(sig, self._shutdown)

        await self._reconcile_devices()
        self._watch_task = asyncio.create_task(self._watch_devices())

        await self._unlink_socket()
        self._server = await asyncio.start_unix_server(
            self._handle_client, path=str(self._socket_path)
        )
        _ = self._socket_path.chmod(0o600)

        try:
            async with self._server:
                _ = await self._shutdown_event.wait()
        finally:
            await self._cleanup()

    # ------------------------------------------------------------- device set

    async def _reconcile_devices(self) -> None:
        """Open devices that appeared and drop those that went away.

        Called on udev events, on every mode change and after a read error, so
        it must be safe to call at any time.
        """
        for node in list(self._devices):
            if not _is_alive(node):
                self._drop_device(node)

        wanted = _readable_input_devices()
        have: Counter[tuple[str, str, str]] = Counter(
            _fingerprint(node.info) for node in self._devices
        )
        for info in wanted:
            fingerprint = _fingerprint(info)
            if have[fingerprint] > 0:
                have[fingerprint] -= 1
                continue
            self._open_one(info)

        if self._devices:
            self._no_devices_warned = False
        elif not self._no_devices_warned:
            self._no_devices_warned = True
            _ = sys.stderr.write(
                "No input devices are readable. Is the daemon running with "
                + "access to /dev/input (SupplementaryGroups=input)?\n"
            )

        if self._mode == MODE_GAMESCOPE:
            self._grab_power_button()

    def _open_one(self, info: _DeviceInfo) -> None:
        try:
            device = _open_device(info.path)
        except OSError as e:
            _ = sys.stderr.write(f"cannot open {info.path}: {e}\n")
            return
        node = _OpenDevice(device=device, info=info)
        self._devices.append(node)
        task = asyncio.create_task(self._read_device(node))
        node.task = task
        # Cleanup rides on the task, not on the coroutine: a task cancelled
        # before it ever ran never executes its own finally block.
        task.add_done_callback(partial(self._on_reader_done, node))

    def _on_reader_done(self, node: _OpenDevice, _task: asyncio.Task[None]) -> None:
        """Release a device whose reader finished, for any reason."""
        self._forget(node)
        if node.failed and not self._shutdown_flag:
            # Unplug or suspend: the device is gone, but the node may already
            # be back, so look for it again.
            _ = sys.stderr.write(f"input device went away: {node.device.path}\n")
            self._schedule_reconcile()

    def _drop_device(self, node: _OpenDevice) -> None:
        """Stop reading a device; the read task closes it in its teardown."""
        # Drop it from the active set immediately: the read task's teardown
        # only runs on the next loop turn, and until then a device that has
        # already come back must not be considered "still open".
        if node in self._devices:
            self._devices.remove(node)
        task = node.task
        if task is None or task is asyncio.current_task() or task.done():
            self._forget(node)
            return
        _ = task.cancel()

    def _forget(self, node: _OpenDevice) -> None:
        """Remove a device from the active set, release and close it."""
        if node in self._devices:
            self._devices.remove(node)
        if node.grabbed:
            with contextlib.suppress(OSError):
                node.device.ungrab()
            node.grabbed = False
        node.task = None
        with contextlib.suppress(OSError):
            node.device.close()

    def _schedule_reconcile(self) -> None:
        """Re-open devices shortly, coalescing bursts of events."""
        if self._shutdown_flag:
            return
        if self._reconcile_task is None or self._reconcile_task.done():
            self._reconcile_task = asyncio.create_task(self._reconcile_soon())

    async def _reconcile_soon(self) -> None:
        try:
            await asyncio.sleep(UDEV_DEBOUNCE_SECONDS)
            await self._reconcile_devices()
        except asyncio.CancelledError:
            raise
        except Exception as e:  # noqa: BLE001 — never let a rescan kill the daemon
            _ = sys.stderr.write(f"device rescan failed: {e}\n")

    async def _watch_devices(self) -> None:
        """Reconcile on udev events, with a periodic safety rescan."""
        monitor = _open_udev_monitor()
        loop = asyncio.get_running_loop()
        wakeup = asyncio.Event()
        fileno = -1
        if monitor is not None:
            fileno = int(monitor.fileno())
            loop.add_reader(fileno, wakeup.set)
            interval = SAFETY_INTERVAL_SECONDS
        else:
            interval = POLL_INTERVAL_SECONDS
            _ = sys.stderr.write(
                "pyudev is unavailable; polling /dev/input every "
                + f"{POLL_INTERVAL_SECONDS:g}s instead of using udev events\n"
            )

        try:
            while not self._shutdown_flag:
                try:
                    if monitor is None:
                        await asyncio.sleep(interval)
                    else:
                        try:
                            _ = await asyncio.wait_for(wakeup.wait(), timeout=interval)
                        except TimeoutError:
                            pass
                        else:
                            wakeup.clear()
                            _drain_udev(monitor)
                            # A single device produces several events; wait for
                            # the burst to settle before reading /dev/input.
                            await asyncio.sleep(UDEV_DEBOUNCE_SECONDS)
                    if self._shutdown_flag:
                        break
                    await self._reconcile_devices()
                except Exception as e:  # noqa: BLE001
                    # Never let one bad event stop the watcher: without it the
                    # daemon would not recover from unplug or suspend again.
                    _ = sys.stderr.write(f"device watcher iteration failed: {e}\n")
                    await asyncio.sleep(interval)
        finally:
            if fileno >= 0:
                _ = loop.remove_reader(fileno)

    async def _unlink_socket(self) -> None:
        try:
            self._socket_path.unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            _ = sys.stderr.write(f"cannot remove stale socket: {e}\n")

    # ----------------------------------------------------------- control API

    async def _handle_client(
        self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter
    ) -> None:
        try:
            raw = (await reader.read(1024)).decode(errors="replace").strip()
        except OSError:
            writer.close()
            return

        response = "error: no response"
        try:
            response = await self._dispatch_command(raw)
        except Exception as e:  # noqa: BLE001 — never let a bad command kill us
            response = f"error: {e}"
        finally:
            try:
                writer.write((response + "\n").encode())
                await writer.drain()
            except OSError:
                pass
            writer.close()

    async def _dispatch_command(self, command: str) -> str:
        async with self._lock:
            if command == MODE_GAMESCOPE:
                await self._set_mode(MODE_GAMESCOPE)
                return MODE_GAMESCOPE
            if command == MODE_DESKTOP:
                await self._set_mode(MODE_DESKTOP)
                return MODE_DESKTOP
            if command == "status":
                return self._mode
            if command == "rescan":
                await self._reconcile_devices()
                return f"rescanned: {len(self._devices)} devices"
            if command == "stop":
                self._shutdown()
                return "stopping"
            return f"error: unknown command {command!r}"

    async def _set_mode(self, mode: str) -> None:
        if mode == self._mode:
            return
        await self._reconcile_devices()
        if mode == MODE_GAMESCOPE:
            self._grab_power_button()
            self._mode = MODE_GAMESCOPE
        else:
            self._ungrab_all()
            self._reset_press_state()
            self._mode = MODE_DESKTOP

    def _grab_power_button(self) -> None:
        for node in self._devices:
            if node.grabbed:
                continue
            if not self._is_power_button(node.device):
                continue
            try:
                node.device.grab()
            except OSError as e:
                _ = sys.stderr.write(f"cannot grab {node.device.path}: {e}\n")
                continue
            node.grabbed = True

    def _ungrab_all(self) -> None:
        for node in self._devices:
            if not node.grabbed:
                continue
            with contextlib.suppress(OSError):
                node.device.ungrab()
            node.grabbed = False

    def _reset_press_state(self) -> None:
        if self._pending_single_task is not None:
            if not self._pending_single_task.done():
                _ = self._pending_single_task.cancel()
            self._pending_single_task = None
        self._press_count = 0
        self._last_press_time = 0.0

    # ------------------------------------------------------------- lifecycle

    def _shutdown(self) -> None:
        self._shutdown_flag = True
        self._shutdown_event.set()

    async def _cleanup(self) -> None:
        self._shutdown_flag = True
        self._reset_press_state()

        background = [task for task in (self._watch_task, self._reconcile_task) if task]
        for task in background:
            _ = task.cancel()
        for task in background:
            with contextlib.suppress(asyncio.CancelledError):
                await task
        self._watch_task = None
        self._reconcile_task = None

        if self._server is not None:
            self._server.close()
            with contextlib.suppress(OSError):
                await self._server.wait_closed()

        # Cancel the readers first: while a read task runs, evdev owns the fd
        # and unregisters it from the event loop in its own teardown.
        readers = [node.task for node in self._devices if node.task is not None]
        for task in readers:
            if not task.done():
                _ = task.cancel()
        for task in readers:
            with contextlib.suppress(asyncio.CancelledError):
                await task
        for node in list(self._devices):
            self._forget(node)
        self._devices.clear()

        try:
            self._socket_path.unlink()
        except FileNotFoundError:
            pass
        except OSError:
            pass

    # ----------------------------------------------------------- event loop

    async def _read_device(self, node: _OpenDevice) -> None:
        """Read one device until it dies; the reader task owns the fd."""
        device = node.device
        try:
            events: AsyncIterator[evdev.InputEvent] = cast(
                "AsyncIterator[evdev.InputEvent]",
                device.async_read_loop(),  # pyright: ignore[reportUnknownMemberType]
            )
            async for event in events:
                if self._mode != MODE_GAMESCOPE:
                    continue
                if event.type != evdev.ecodes.EV_KEY:
                    continue
                if event.code == evdev.ecodes.KEY_POWER:
                    if event.value == 1:
                        self._on_power_press()
                    continue
                if event.value == 1:
                    if event.code == evdev.ecodes.KEY_VOLUMEUP:
                        await self._set_volume("5%+")
                    elif event.code == evdev.ecodes.KEY_VOLUMEDOWN:
                        await self._set_volume("5%-")
                    elif event.code == evdev.ecodes.KEY_MUTE:
                        await self._toggle_mute()
        except asyncio.CancelledError:
            raise
        except OSError as e:
            node.failed = True
            if e.errno != errno.ENODEV:
                _ = sys.stderr.write(f"evdev error on {device.path}: {e}\n")
        except Exception as e:  # noqa: BLE001 — last-resort guard for evdev reads
            node.failed = True
            _ = sys.stderr.write(f"unexpected error on {device.path}: {e}\n")

    @staticmethod
    def _is_power_button(device: evdev.InputDevice[str]) -> bool:
        if device.name != "Power Button":
            return False
        return device.phys in POWER_BUTTON_PHYS

    def _on_power_press(self) -> None:
        now = asyncio.get_running_loop().time()
        if now - self._last_press_time <= DOUBLE_PRESS_SECONDS:
            self._press_count += 1
        else:
            self._press_count = 1
        self._last_press_time = now
        self._reset_pending_task()
        if self._press_count >= 2:
            self._press_count = 0
            self._last_press_time = 0.0
            self._pending_single_task = asyncio.create_task(
                self._run_steam_command(STEAM_URL_SLEEP)
            )
            return
        self._pending_single_task = asyncio.create_task(self._single_press_timer())

    def _reset_pending_task(self) -> None:
        if self._pending_single_task is not None:
            if not self._pending_single_task.done():
                _ = self._pending_single_task.cancel()
            self._pending_single_task = None

    async def _single_press_timer(self) -> None:
        try:
            await asyncio.sleep(DOUBLE_PRESS_SECONDS)
        except asyncio.CancelledError:
            return
        self._pending_single_task = None
        self._press_count = 0
        await self._run_steam_command(STEAM_URL_MENU)

    # -------------------------------------------------------------- actions

    async def _run_steam_command(self, url: str) -> None:
        steam = Path.home() / ".local/share/Steam/ubuntu12_32/steam"
        if not steam.exists():
            _ = sys.stderr.write(f"steam binary not found: {steam}\n")
            return
        try:
            proc = await asyncio.create_subprocess_exec(
                steam,
                "-ifrunning",
                url,
                stdout=asyncio.subprocess.DEVNULL,
                stderr=asyncio.subprocess.DEVNULL,
            )
            _ = await proc.wait()
        except OSError as e:
            _ = sys.stderr.write(f"failed to run steam command {url}: {e}\n")

    async def _set_volume(self, delta: str) -> None:
        limit = "1.0" if delta.endswith("+") else "0.0"
        await self._run_wpctl("set-volume", "@DEFAULT_AUDIO_SINK@", delta, "-l", limit)

    async def _toggle_mute(self) -> None:
        await self._run_wpctl("set-mute", "@DEFAULT_AUDIO_SINK@", "toggle")

    @staticmethod
    async def _run_wpctl(*args: str) -> None:
        try:
            proc = await asyncio.create_subprocess_exec(
                "wpctl",
                *args,
                stdout=asyncio.subprocess.DEVNULL,
                stderr=asyncio.subprocess.DEVNULL,
            )
            returncode = await proc.wait()
        except OSError as e:
            _ = sys.stderr.write(f"failed to run wpctl {args}: {e}\n")
            return
        if returncode != 0:
            _ = sys.stderr.write(f"wpctl {args} exited with {returncode}\n")


def _resolve_socket() -> Path:
    """Priority: --socket PATH > $GAMESCOPE_INPUT_DAEMON_SOCKET > default."""
    argv = sys.argv[1:]
    if argv:
        if len(argv) == 2 and argv[0] == "--socket":
            return Path(argv[1])
        _ = sys.stderr.write(f"usage: {sys.argv[0]} [--socket PATH]\n")
        sys.exit(2)
    env = os.environ.get("GAMESCOPE_INPUT_DAEMON_SOCKET")
    return Path(env) if env else DEFAULT_SOCKET


async def _main() -> None:
    daemon = InputDaemon(_resolve_socket())
    await daemon.start()


if __name__ == "__main__":
    try:
        asyncio.run(_main())
    except KeyboardInterrupt:
        pass
